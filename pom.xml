<groupId>com.example.security</groupId>
<artifactId>vulnerable-dependency-demo</artifactId>
<version>1.0-SNAPSHOT</version>

<name>Exploitable Dependency Demo</name>
<description>A sample Maven project containing a known exploited vulnerability for testing scanners.</description>

<properties>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
</properties>

<dependencies>
